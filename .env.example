# Real values live only in .env.local (gitignored) and Vercel env vars -- never commit them here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Firebase Auth (shared with Handychapter and bni-rrc-slips, project: handy-chapter)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cross-app SSO (separate domains, bridged via a redirect + one-time code exchange rather than
# a shared cookie -- see components/AppShell.tsx and lib/sso-partners.ts). Handychapter is the
# single auth hub: this app has no login screen of its own in normal use, and defers to the hub
# whenever there's no local session. NEXT_PUBLIC_SSO_PARTNER_URLS is used only to broadcast
# logout to every other app sharing this Firebase project, not for login.
# bni-rrc's own URL is https://bni-rrc-flax.vercel.app -- NOT https://bni-rrc.vercel.app, a
# separate older deployment.
NEXT_PUBLIC_SSO_HUB_URL=
NEXT_PUBLIC_SSO_PARTNER_URLS=

# Firebase service account for handy-chapter (Firebase Console -> Project Settings ->
# Service Accounts -> Generate new private key). Server-only: mints/verifies SSO tokens.
# Never prefix these with NEXT_PUBLIC_ -- they must not reach the browser.
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
SUPABASE_DB_URL=
SKIP_DB_MIGRATIONS=

# Gemini (Chapter AI chat: server-side key used by /api/chat/generate; never client-side).
# When absent, the chat falls back to the local rule engine automatically.
GEMINI_API_KEY=

# Display name used by Chapter AI in messages and prompts.
NEXT_PUBLIC_CHAPTER_NAME=BNI Chapter
