# Cross-app SSO (separate domains, bridged via a redirect + one-time code exchange rather than
# a shared cookie -- see app/sso/* and lib/sso-partners.ts). Comma-separated list of every OTHER
# trusted app sharing the handydash-75858 Firebase project; add more here as they're built.
# Each of those apps needs its own equivalent list including https://bni-rrc.vercel.app.
NEXT_PUBLIC_SSO_PARTNER_URLS=https://www.handychapter.com

# Firebase service account for handydash-75858 (Firebase Console -> Project Settings ->
# Service Accounts -> Generate new private key). Server-only: mints/verifies SSO tokens.
# Never prefix these with NEXT_PUBLIC_ -- they must not reach the browser.
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Gemini (Chapter AI chat: server-side key used by /api/chat/generate; never client-side).
# When absent, the chat falls back to the local rule engine automatically.
GEMINI_API_KEY=

# Display name used by Chapter AI in messages and prompts.
NEXT_PUBLIC_CHAPTER_NAME=BNI Chapter