# Real values live only in .env.local (gitignored) and Vercel env vars -- never commit them here.
NEXT_PUBLIC_SUPABASE_URL=https://lvijvkqvruygdesgxvch.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Firebase Auth (shared with Handychapter and bni-rrc-slips, project: handy-chapter)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=handy-chapter.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://handy-chapter-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=handy-chapter
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=handy-chapter.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cross-app SSO (separate domains, bridged via a redirect + one-time code exchange rather than
# a shared cookie -- see app/sso/* and lib/sso-partners.ts). Comma-separated list of every OTHER
# trusted app sharing the handy-chapter Firebase project; add more here as they're built.
# Each of those apps needs its own equivalent list including bni-rrc's own URL, which is
# https://bni-rrc-flax.vercel.app -- NOT https://bni-rrc.vercel.app, a separate older deployment.
NEXT_PUBLIC_SSO_PARTNER_URLS=https://www.handychapter.com,https://bni-rrc-slips.vercel.app

# Firebase service account for handy-chapter (Firebase Console -> Project Settings ->
# Service Accounts -> Generate new private key). Server-only: mints/verifies SSO tokens.
# Never prefix these with NEXT_PUBLIC_ -- they must not reach the browser.
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
SUPABASE_DB_URL=
SKIP_DB_MIGRATIONS=

# Gemini (Chapter AI chat: server-side key used by /api/chat/generate; never client-side).
# When absent, the chat falls back to the local rule engine automatically.
GEMINI_API_KEY=

# Display name used by Chapter AI in messages and prompts.
NEXT_PUBLIC_CHAPTER_NAME=BNI Chapter
